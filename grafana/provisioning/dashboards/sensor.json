{
  "kind": "Panel",
  "spec": {
    "id": 2,
    "title": "influxdb",
    "description": "",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "version": "v0",
                "group": "influxdb",
                "datasource": {
                  "name": "bftlhsfu5hxc0f"
                },
                "spec": {
                  "query": "from(bucket: \"telemetry_raw\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"telemetry_reading\")\r\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\r\n  |> filter(fn: (r) => r[\"station_id\"] == \"${stationId}\")\r\n  |> filter(fn: (r) => r[\"sensor_id\"] == \"${sensorId}\")\r\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\r\n  |> yield(name: \"mean\")\r\n"
                }
              },
              "refId": "A",
              "hidden": false
            }
          }
        ],
        "transformations": [],
        "queryOptions": {}
      }
    },
